# Copy to .env and fill in. Never commit real secrets.

# --- Database (docker compose up -d db) ---
DATABASE_URL=postgresql://canesat:canesat@localhost:5433/canesat

# --- Pipeline ---
# Directory for cached cane-pixel masks (likely-cane reference masks per plot)
CANESAT_CACHE_DIR=.cache/canesat
# Optional: Planetary Computer subscription key (not required; anonymous signing works)
PC_SDK_SUBSCRIPTION_KEY=

# --- LINE (later milestone: LINE OA webhook / push) ---
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# --- LIFF (later milestone: plot registration / plot page) ---
LIFF_ID=

# --- NASA Earthdata (later milestone: GPM IMERG rain + SMAP soil moisture) ---
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# --- NASA Earthdata (GPM IMERG rain + SMAP soil moisture) ---
# Prefer a bearer token from https://urs.earthdata.nasa.gov/profile (Generate Token)
EARTHDATA_TOKEN=
# Legacy basic-auth keys (unused by canesat; token preferred):
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# --- Push alerts (LINE OA Free = 300 msgs/month) ---
# Default OFF. Do NOT set true on Railway without Sam saying yes.
ENABLE_PUSH_ALERTS=false
# Public HTTPS origin of the bot (for chart deep links in alerts)
PUBLIC_BASE_URL=
